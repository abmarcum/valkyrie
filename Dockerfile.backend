FROM node:24-bookworm-slim

WORKDIR /app

# Install OpenSSL required by Prisma query engine and Git for VCS operations
RUN apt-get update -y && apt-get install -y openssl ca-certificates git

# Copy monorepo configuration and lockfiles
COPY package.json package-lock.json tsconfig.json ./
COPY apps/orchestrator ./apps/orchestrator
COPY packages/db ./packages/db

# Install dependencies
RUN npm ci

# Generate Prisma client and compile TypeScript orchestrator backend
RUN npx prisma generate --schema=packages/db/prisma/schema.prisma
RUN npm run build --workspace=@valkyrie/orchestrator

EXPOSE 4000

# Start production Fastify orchestrator backend with automated schema push
CMD ["sh", "-c", "npx prisma db push --schema=packages/db/prisma/schema.prisma && node apps/orchestrator/dist/index.js"]
