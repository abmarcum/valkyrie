# Valkyrie Workspace Environment Variables

# SQLite connection path for Prisma
DATABASE_URL="file:./dev.db"

# Postgres connection path for Prisma
# DATABASE_URL="postgresql://valkyrie:valkyrie@localhost/valkyrie"

# Google Gemini API key for live multi-agent execution
GEMINI_API_KEY="your_gemini_api_key_here"

# Anthropic API key for Claude 4.5 Sonnet live execution
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Cohere API key for refining and auditing AI calls
COHERE_API_KEY="your_cohere_api_key_here"

# GitHub credential authorization for remote VCS pushes
GITHUB_TOKEN="your_github_personal_access_token_here"

# Ollama local inference endpoint URL
OLLAMA_IP="http://127.0.0.1:11434"

# Internal daemon authentication secret between orchestrator and QA runner
ORCHESTRATOR_INTERNAL_SECRET="valkyrie_internal_daemon_secret"

# LangSmith LLM generation tracing setup
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="ls__your_langsmith_api_key_here"
LANGCHAIN_PROJECT="valkyrie"
